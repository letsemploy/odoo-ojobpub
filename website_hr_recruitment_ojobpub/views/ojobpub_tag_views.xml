<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ojobpub_tag_view_list" model="ir.ui.view">
        <field name="name">ojobpub.tag.list</field>
        <field name="model">ojobpub.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="ojobpub_tag_action" model="ir.actions.act_window">
        <field name="name">oJobPub Keywords</field>
        <field name="res_model">ojobpub.tag</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_ojobpub_tag"
              name="oJobPub Keywords"
              parent="hr_recruitment.menu_hr_recruitment_config_jobs"
              action="ojobpub_tag_action"
              sequence="50"/>
</odoo>
